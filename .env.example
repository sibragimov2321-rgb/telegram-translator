# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Recommended: create an API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional fallback if OpenRouter is not configured.
OPENAI_API_KEY=

# OpenRouter model slug. For direct OpenAI use, remove the "openai/" prefix.
TRANSLATION_MODEL=openai/gpt-4.1-mini

# Enables the isolated conversational Russian ↔ Kyrgyz pipeline.
KYRGYZ_CONVERSATIONAL_MODE=false

# Enables the isolated conversational Russian ↔ Turkmen pipeline.
TM_CONVERSATIONAL_MODE=false

# tm_ascii_chat (current bot default), tm_native, or chat_native.
TM_OUTPUT_STYLE=tm_ascii_chat
